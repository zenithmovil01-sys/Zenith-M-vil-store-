dow);display:grid;grid-template-columns:42px 1fr;gap:12px;align-items:center}.payment-icon{width:40px;height:40px;display:grid;place-items:center;background:#edf6df;color:var(--green);border-radius:12px;font-weight:800}.payment-card b,.payment-card small{display:block}.payment-card b{font-size:13px}.payment-card small{font-size:11px;line-height:1.5;color:var(--muted);margin-top:5px}.payment-divider{grid-column:1/-1;height:1px;background:var(--line);margin:4px 0}.delivery-section{max-width:1100px;width:88%;margin:40px auto;display:flex;align-items:center;gap:18px;padding:24px;border:1px solid var(--line);border-radius:17px}.delivery-icon{font-size:31px;background:#eff5e9;width:60px;height:60px;display:grid;place-items:center;border-radius:15px;flex-shrink:0}.delivery-section h2{font-size:21px}.delivery-section p{font-size:12px;color:var(--muted);line-height:1.7;margin-bottom:0}footer{background:#102d20;color:#fff;padding:28px 6%;display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap}.footer-brand .brand-mark{background:#2c5b40}footer p,footer>small{font-size:11px;color:#c2d0c7}.backdrop{position:fixed;inset:0;background:#0c1b13a6;z-index:10}.hidden{display:none!important}.cart-panel{position:fixed;z-index:11;right:0;top:0;height:100dvh;width:min(440px,100%);background:#fff;box-shadow:-20px 0 60px #0002;transform:translateX(105%);transition:transform .25s ease;display:flex;flex-direction:column;padding:23px}.cart-panel.open{transform:translateX(0)}.cart-head{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:17px}.cart-head h2{font-family:Manrope;margin:0;font-size:27px}.cart-head .eyebrow{margin-bottom:5px}.icon-button{border:1px solid var(--line);background:#fff;border-radius:9px;width:38px;height:38px;cursor:pointer}.cart-items{overflow:auto;flex:1;padding:12px 0}.empty-cart{color:var(--muted);font-size:13px;text-align:center;padding:25px}.cart-item{display:grid;grid-template-columns:48px 1fr auto;gap:10px;align-items:center;padding:13px 0;border-bottom:1px solid var(--line)}.cart-emoji{width:46px;height:46px;display:grid;place-items:center;border-radius:10px;background:#f0f5ec;font-size:24px}.cart-item b{display:block;font-size:12px}.cart-item small{display:block;color:var(--muted);font-size:11px;margin-top:4px}.qty{display:flex;align-items:center;gap:8px;margin-top:7px}.qty button{width:23px;height:23px;border:1px solid var(--line);background:#fff;border-radius:6px;cursor:pointer}.cart-item .remove{border:0;background:none;color:#8b4a40;cursor:pointer;font-size:11px}.cart-bottom{border-top:1px solid var(--line);padding-top:15px;max-height:57%;overflow:auto}.cart-total{display:flex;justify-content:space-between;align-items:center}.cart-total span{font-size:12px;color:var(--muted)}.cart-total strong{font:800 22px Manrope;color:var(--green)}.small-note{font-size:10px;color:var(--muted);line-height:1.5}#checkout-form{display:grid;gap:11px}#checkout-form label{display:grid;gap:5px;font-size:11px;font-weight:700}#checkout-form input,#checkout-form textarea{width:100%;border:1px solid var(--line);border-radius:8px;padding:10px;font-size:12px;outline-color:#8cb49a;resize:vertical}.text-button{display:block;margin:10px auto 0;border:0;background:none;color:#8b4a40;font-size:11px;cursor:pointer}
