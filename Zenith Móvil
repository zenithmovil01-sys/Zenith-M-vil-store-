@media(min-width:761px) and (max-width:1000px){.product-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.hero-art{min-height:310px}}
/*
 * Zenith Móvil — configuración de tienda.
 * Antes de publicar: confirma precios, disponibilidad, políticas y número de WhatsApp.
 * Usa el número internacional sin +, espacios ni guiones.
 */
const STORE = {
  name: "Zenith Móvil",
  currency: "HNL",
  locale: "es-HN",
  whatsappNumber: "50493979268",
  paymentMessage: "Aceptamos transferencia bancaria o depósito. Solicita los datos oficiales y confirma las condiciones antes de pagar."
};

// Productos de demostración: reemplaza nombres, precios, fotos y disponibilidad antes de publicar.
const PRODUCTS = [
  {id:1,name:"Samsung Galaxy S24 Ultra",category:"Teléfonos",description:"Teléfono premium. Consulta colores y almacenamiento.",price:14500,emoji:"📱",bg:"#e9efe4"},
  {id:2,name:"iPhone 15 Pro Max",category:"Teléfonos",description:"Diseño elegante y alto rendimiento.",price:12000,emoji:"📲",bg:"#f1e8df"},
  {id:3,name:"Aire acondicionado 12,000 BTU",category:"Electrodomésticos",description:"Consulta voltaje, instalación y disponibilidad.",price:5500,emoji:"❄️",bg:"#e4f1f6"},
  {id:4,name:"Televisor UHD",category:"Electrónica",description:"Pantalla UHD. Confirma tamaño y modelo.",price:8500,emoji:"📺",bg:"#eae8f4"},
  {id:5,name:"Samsung Galaxy A Series",category:"Teléfonos",description:"Varias opciones disponibles bajo consulta.",price:3000,emoji:"📱",bg:"#e8edf8"},
  {id:6,name:"Lavadora",category:"Electrodomésticos",description:"Consulta capacidad, marca y entrega.",price:7000,emoji:"🧺",bg:"#e7f2ed"},
  {id:7,name:"Consola de videojuegos",category:"Electrónica",description:"Consulta versión, controles y disponibilidad.",price:9500,emoji:"🎮",bg:"#f4e8e6"},
  {id:8,name:"Accesorios para teléfono",category:"Electrónica",description:"Consulta modelos y compatibilidad.",price:350,emoji:"🎧",bg:"#f5f0dc"}
];

let cart = [];
let activeCategory = "Todos";
const money = value => new Intl.NumberFormat(STORE.locale,{style:"currency",currency:STORE.currency,maximumFractionDigits:0}).format(value).replace("HNL","L");
const grid = document.getElementById("product-grid");
const search = document.getElementById("search");

function renderProducts(){
  const term = search.value.trim().toLocaleLowerCase("es");
  const list = PRODUCTS.filter(p => (activeCategory==="Todos" || p.category===activeCategory) && (p.name+" "+p.description+" "+p.category).toLocaleLowerCase("es").includes(term));
  grid.innerHTML = list.length ? list.map(p => `
    <article class="product-card">
      <div class="product-visual" style="background:${p.bg}"><span class="product-category">${p.category}</span><span class="emoji" aria-hidden="true">${p.emoji}</span></div>
      <div class="product-info"><h3>${escapeHtml(p.name)}</h3><p>${escapeHtml(p.description)}</p>
      <div class="product-price">${money(p.price)} <small>HNL</small></div>
      <button class="add-button" data-add="${p.id}">Agregar al carrito +</button></div>
    </article>`).join("") : `<p>No encontramos productos con esa búsqueda.</p>`;
  grid.querySelectorAll("[data-add]").forEach(btn => btn.addEventListener("click",()=>addToCart(Number(btn.dataset.add))));
}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
function addToCart(id){const found=cart.find(x=>x.id===id);if(found)found.qty++;else cart.push({id,qty:1});renderCart();openCart();}
function changeQty(id,delta){const item=cart.find(x=>x.id===id);if(!item)return;item.qty+=delta;if(item.qty<=0)cart=cart.filter(x=>x.id!==id);renderCart();}
function removeItem(id){cart=cart.filter(x=>x.id!==id);renderCart();}
function renderCart(){
  const count=cart.reduce((n,x)=>n+x.qty,0),total=cart.reduce((n,x)=>n+PRODUCTS.find(p=>p.id===x.id).price*x.qty,0);
  document.getElementById("cart-count").textContent=count;
  document.getElementById("cart-total").textContent=money(total);
  const holder=document.getElementById("cart-items");
  holder.innerHTML=cart.length?cart.map(x=>{const p=PRODUCTS.find(q=>q.id===x.id);return `<div class="cart-item"><div class="cart-emoji">${p.emoji}</div><div><b>${escapeHtml(p.name)}</b><small>${money(p.price)} c/u</small><div class="qty"><button data-minus="${p.id}" aria-label="Restar">−</button><span>${x.qty}</span><button data-plus="${p.id}" aria-label="Sumar">+</button></div></div><button class="remove" data-remove="${p.id}">Quitar</button></div>`}).join(""):`<p class="empty-cart">Tu carrito está vacío.</p>`;
  holder.querySelectorAll("[data-minus]").forEach(b=>b.addEventListener("click",()=>changeQty(Number(b.dataset.minus),-1)));
  holder.querySelectorAll("[data-plus]").forEach(b=>b.addEventListener("click",()=>changeQty(Number(b.dataset.plus),1)));
  holder.querySelectorAll("[data-remove]").forEach(b=>b.addEventListener("click",()=>removeItem(Number(b.dataset.remove))));
}
function openCart(){document.getElementById("cart-panel").classList.add("open");document.getElementById("cart-panel").setAttribute("aria-hidden","false");document.getElementById("cart-backdrop").classList.remove("hidden");}
function closeCart(){document.getElementById("cart-panel").classList.remove("open");document.getElementById("cart-panel").setAttribute("aria-hidden","true");document.getElementById("cart-backdrop").classList.add("hidden");}
document.getElementById("cart-open").addEventListener("click",openCart);
document.getElementById("cart-close").addEventListener("click",closeCart);
document.getElementById("cart-backdrop").addEventListener("click",closeCart);
document.getElementById("clear-cart").addEventListener("click",()=>{cart=[];renderCart();});
document.getElementById("checkout-form").addEventListener("submit",e=>{
  e.preventDefault();
  if(!cart.length){alert("Agrega al menos un producto al carrito.");return;}
  if(!STORE.whatsappNumber || STORE.whatsappNumber.includes("CAMBIAR")){alert("Configura el número de WhatsApp en app.js antes de recibir pedidos.");return;}
